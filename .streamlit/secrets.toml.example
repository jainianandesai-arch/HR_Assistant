ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: point at a hosted Postgres instance (Supabase, Neon, Railway, etc.) for a durable
# audit trail / query log / saved scenarios that survive redeploys. Omit to use a local SQLite
# file instead (fine for local dev, but resets on every Streamlit Cloud redeploy).
# DATABASE_URL = "postgresql://user:password@host:5432/dbname"

# Optional: Slack or Microsoft Teams incoming webhook URL. When set, the nightly refresh posts a
# message here whenever it detects a material change to a government source page.
# CHANGE_NOTIFY_WEBHOOK_URL = "https://hooks.slack.com/services/..."
